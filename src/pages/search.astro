---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/ui/AdSlot.astro';
import { getCollection } from 'astro:content';

const shows = await getCollection('shows');
const episodes = await getCollection('episodes');

// Build lightweight searchable items for client-side search
const searchData = [
	...shows.map((s) => ({
		type: 'show' as const,
		id: s.data.slug,
		title: s.data.name,
		subtitle: `${s.data.seasons} ${s.data.seasons === 1 ? 'Season' : 'Seasons'}`,
		description: s.data.description,
		url: `/shows/${s.data.slug}`,
		poster: s.data.poster,
		trending: s.data.trending,
		featured: s.data.featured,
	})),
	...episodes.map((ep) => ({
		type: 'episode' as const,
		id: `${ep.data.showSlug}-season-${ep.data.seasonNumber}-episode-${ep.data.episodeNumber}`,
		title: ep.data.title,
		subtitle: `${ep.data.showName} • S${ep.data.seasonNumber} E${ep.data.episodeNumber}`,
		description: ep.data.description,
		url: `/watch/${ep.data.showSlug}-season-${ep.data.seasonNumber}-episode-${ep.data.episodeNumber}`,
		poster: ep.data.poster,
		trending: false,
		featured: ep.data.featured,
	})),
];
---

<Layout
	title="Search Shows & Episodes - RealityStream"
	description="Search our entire catalog of Indian reality shows, seasons, and episodes."
>
	<section class="py-12 sm:py-16 bg-ink-soft/20 min-h-[75vh]">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<!-- Header and Search Bar -->
			<div class="max-w-3xl mx-auto text-center mb-10">
				<h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-display mb-3">
					Search Reality Shows & Episodes
				</h1>
				<p class="text-white/60 text-base mb-8">
					Find full episodes, favorite moments, and all seasons across the entire RealityStream library.
				</p>

				<!-- Search Input -->
				<div class="relative w-full">
					<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-white/40">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
						</svg>
					</div>
					<input
						type="search"
						id="search-input"
						placeholder="Search by show title, episode name, or topic (e.g. Bigg Boss, Nominations)..."
						class="w-full pl-12 pr-12 py-3.5 bg-ink-700/80 border border-ink-600 rounded-2xl text-white placeholder-white/40 text-base focus:outline-none focus:ring-2 focus:ring-brand-orange focus:border-brand-orange transition shadow-card"
						autocomplete="off"
					/>
					<button
						id="clear-btn"
						type="button"
						class="absolute inset-y-0 right-0 pr-4 flex items-center text-white/40 hover:text-white hidden"
						aria-label="Clear search query"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>
				</div>

				<!-- Suggested Quick Tags -->
				<div class="flex flex-wrap items-center justify-center gap-2 mt-4 text-xs">
					<span class="text-white/40">Try:</span>
					<button class="quick-tag px-3 py-1 rounded-full bg-ink-700 text-white/70 hover:text-white hover:bg-brand-orange/20 hover:border-brand-orange/40 border border-ink-600 transition">
						Bigg Boss
					</button>
					<button class="quick-tag px-3 py-1 rounded-full bg-ink-700 text-white/70 hover:text-white hover:bg-brand-orange/20 hover:border-brand-orange/40 border border-ink-600 transition">
						Roadies
					</button>
					<button class="quick-tag px-3 py-1 rounded-full bg-ink-700 text-white/70 hover:text-white hover:bg-brand-orange/20 hover:border-brand-orange/40 border border-ink-600 transition">
						Splitsvilla
					</button>
					<button class="quick-tag px-3 py-1 rounded-full bg-ink-700 text-white/70 hover:text-white hover:bg-brand-orange/20 hover:border-brand-orange/40 border border-ink-600 transition">
						Premiere
					</button>
				</div>
			</div>

			<!-- Filter tabs (All, Shows, Episodes) -->
			<div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-ink-700/60">
				<div class="flex items-center gap-2">
					<button id="filter-all" class="tab-btn px-4 py-2 rounded-lg text-sm font-semibold bg-brand-orange text-black">
						All Results
					</button>
					<button id="filter-shows" class="tab-btn px-4 py-2 rounded-lg text-sm font-semibold text-white/70 hover:text-white hover:bg-white/5">
						Shows Only
					</button>
					<button id="filter-episodes" class="tab-btn px-4 py-2 rounded-lg text-sm font-semibold text-white/70 hover:text-white hover:bg-white/5">
						Episodes Only
					</button>
				</div>
				<span id="result-count" class="text-xs text-white/50">
					Showing all {searchData.length} items
				</span>
			</div>

			<!-- Results Container -->
			<div id="results-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
				<!-- Dynamically populated by JS -->
			</div>

			<!-- Empty State -->
			<div id="no-results" class="hidden text-center py-16 bg-ink-soft/40 rounded-2xl border border-ink-700/60">
				<div class="w-16 h-16 rounded-full bg-ink-700 flex items-center justify-center mx-auto mb-4 text-white/40">
					<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
				</div>
				<h3 class="text-lg font-bold text-white mb-1">No matching results found</h3>
				<p class="text-sm text-white/50 mb-6 max-w-sm mx-auto">
					We couldn't find anything matching your search. Try searching for a different show name or keyword.
				</p>
				<button id="reset-search" class="px-5 py-2.5 rounded-lg bg-brand-orange text-black font-semibold text-sm">
					Clear Search
				</button>
			</div>

			<!-- Ad slot -->
			<div class="mt-16">
				<AdSlot
					id="search-results-ad"
					label="Search Results Banner"
					placement="between-lists"
					width="max-w-7xl mx-auto"
				/>
			</div>
		</div>
	</section>

	<script define:vars={{ searchData }}>
		let activeFilter = 'all';
		let currentQuery = '';

		const searchInput = document.getElementById('search-input');
		const clearBtn = document.getElementById('clear-btn');
		const resultsGrid = document.getElementById('results-grid');
		const noResults = document.getElementById('no-results');
		const resultCount = document.getElementById('result-count');
		const tabAll = document.getElementById('filter-all');
		const tabShows = document.getElementById('filter-shows');
		const tabEpisodes = document.getElementById('filter-episodes');
		const resetSearchBtn = document.getElementById('reset-search');
		const quickTags = document.querySelectorAll('.quick-tag');

		function renderResults() {
			const query = currentQuery.trim().toLowerCase();
			let filtered = searchData.filter((item) => {
				// Type filter
				if (activeFilter === 'shows' && item.type !== 'show') return false;
				if (activeFilter === 'episodes' && item.type !== 'episode') return false;

				// Text query
				if (!query) return true;
				return (
					item.title.toLowerCase().includes(query) ||
					item.subtitle.toLowerCase().includes(query) ||
					item.description.toLowerCase().includes(query)
				);
			});

			if (filtered.length === 0) {
				resultsGrid.innerHTML = '';
				noResults.classList.remove('hidden');
				resultCount.textContent = '0 results';
				return;
			}

			noResults.classList.add('hidden');
			resultCount.textContent = `Showing ${filtered.length} ${filtered.length === 1 ? 'result' : 'results'}`;

			resultsGrid.innerHTML = filtered
				.map((item) => {
					const badge =
						item.type === 'show'
							? `<span class="rounded bg-brand-orange/90 px-2 py-0.5 text-xs font-bold text-black">SHOW</span>`
							: `<span class="rounded bg-brand-red/90 px-2 py-0.5 text-xs font-bold text-white">EPISODE</span>`;

					return `
						<a
							href="${item.url}"
							class="group relative block overflow-hidden rounded-xl bg-ink-soft card-lift border border-ink-700/50 hover:border-brand-orange/50 transition-all"
						>
							<div class="relative ${item.type === 'show' ? 'aspect-[2/3]' : 'aspect-video'} w-full overflow-hidden">
								<img
									src="${item.poster}"
									alt="${item.title}"
									loading="lazy"
									class="w-full h-full object-cover transition duration-500 group-hover:scale-105"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent">
									<div class="absolute top-3 left-3">
										${badge}
									</div>
									<div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4">
										<p class="text-xs text-brand-orange font-semibold mb-0.5">${item.subtitle}</p>
										<h3 class="line-clamp-1 text-base font-bold text-white">${item.title}</h3>
										<p class="mt-1 line-clamp-2 text-xs text-white/60">${item.description}</p>
									</div>
								</div>
							</div>
						</a>
					`;
				})
				.join('');
		}

		function updateTabs() {
			[tabAll, tabShows, tabEpisodes].forEach((tab) => {
				tab.className = 'tab-btn px-4 py-2 rounded-lg text-sm font-semibold text-white/70 hover:text-white hover:bg-white/5 transition';
			});
			if (activeFilter === 'all') tabAll.className = 'tab-btn px-4 py-2 rounded-lg text-sm font-semibold bg-brand-orange text-black shadow-glow';
			if (activeFilter === 'shows') tabShows.className = 'tab-btn px-4 py-2 rounded-lg text-sm font-semibold bg-brand-orange text-black shadow-glow';
			if (activeFilter === 'episodes') tabEpisodes.className = 'tab-btn px-4 py-2 rounded-lg text-sm font-semibold bg-brand-orange text-black shadow-glow';
		}

		tabAll?.addEventListener('click', () => {
			activeFilter = 'all';
			updateTabs();
			renderResults();
		});

		tabShows?.addEventListener('click', () => {
			activeFilter = 'shows';
			updateTabs();
			renderResults();
		});

		tabEpisodes?.addEventListener('click', () => {
			activeFilter = 'episodes';
			updateTabs();
			renderResults();
		});

		searchInput?.addEventListener('input', (e) => {
			currentQuery = e.target.value;
			clearBtn?.classList.toggle('hidden', !currentQuery);
			renderResults();
		});

		clearBtn?.addEventListener('click', () => {
			if (searchInput) {
				searchInput.value = '';
				currentQuery = '';
				clearBtn.classList.add('hidden');
				searchInput.focus();
				renderResults();
			}
		});

		resetSearchBtn?.addEventListener('click', () => {
			if (searchInput) {
				searchInput.value = '';
				currentQuery = '';
				clearBtn?.classList.add('hidden');
				activeFilter = 'all';
				updateTabs();
				renderResults();
			}
		});

		quickTags.forEach((tag) => {
			tag.addEventListener('click', () => {
				const val = tag.textContent.trim();
				if (searchInput) {
					searchInput.value = val;
					currentQuery = val;
					clearBtn?.classList.remove('hidden');
					renderResults();
				}
			});
		});

		// Parse ?q= from URL if present
		const params = new URLSearchParams(window.location.search);
		const initialQ = params.get('q');
		if (initialQ && searchInput) {
			searchInput.value = initialQ;
			currentQuery = initialQ;
			clearBtn?.classList.remove('hidden');
		}

		// Initial render
		renderResults();
	</script>
</Layout>