---
const currentPath = Astro.url.pathname;

const navLinks = [
	{ label: 'Home', href: '/' },
	{ label: 'Shows', href: '/shows' },
	{ label: 'Episodes', href: '/episodes' },
	{ label: 'Trending', href: '/shows?filter=trending' },
];

const isActive = (href: string) => {
	if (href === '/') return currentPath === '/';
	return currentPath.startsWith(href.split('?')[0]);
};
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-ink/90 border-b border-ink-700/60 transition-all duration-300">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between h-16 sm:h-20">
			<!-- Logo -->
			<div class="flex items-center gap-8">
				<a href="/" class="flex items-center gap-2.5 group">
					<div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-red via-brand-orange to-brand-gold flex items-center justify-center shadow-glow group-hover:scale-105 transition-transform duration-300">
						<svg class="w-5 h-5 text-black ml-0.5" fill="currentColor" viewBox="0 0 24 24">
							<path d="M8 5v14l11-7z" />
						</svg>
					</div>
					<div class="flex flex-col">
						<span class="text-xl sm:text-2xl font-extrabold tracking-tight text-white font-display">
							Reality<span class="bg-gradient-to-r from-brand-orange via-brand-orange-soft to-brand-red bg-clip-text text-transparent">Stream</span>
						</span>
						<span class="text-[10px] uppercase tracking-widest text-white/50 -mt-1 font-semibold">Indian Reality TV</span>
					</div>
				</a>

				<!-- Desktop Navigation Links -->
				<nav class="hidden md:flex items-center gap-1">
					{navLinks.map((link) => {
						const active = isActive(link.href);
						return (
							<a
								href={link.href}
								class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
									active
										? 'bg-brand-orange/15 text-brand-orange font-semibold border border-brand-orange/30 shadow-sm'
										: 'text-white/75 hover:text-white hover:bg-white/5'
								}`}
							>
								{link.label}
							</a>
						);
					})}
				</nav>
			</div>

			<!-- Right Actions: Search + CTA -->
			<div class="flex items-center gap-3">
				<!-- Search Button -->
				<a
					href="/search"
					class="flex items-center gap-2 px-3.5 py-2 rounded-lg bg-ink-700/70 border border-ink-600/60 text-white/75 hover:text-white hover:border-brand-orange/50 hover:bg-ink-700 transition group"
					aria-label="Search shows and episodes"
				>
					<svg class="w-4 h-4 text-white/60 group-hover:text-brand-orange transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
					</svg>
					<span class="hidden sm:inline text-xs font-medium">Search...</span>
					<kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono text-white/40 bg-ink-800 rounded border border-ink-600">/</kbd>
				</a>

				<!-- Mobile Hamburger Menu Button -->
				<button
					id="mobile-menu-btn"
					type="button"
					class="md:hidden p-2 rounded-lg bg-ink-700/70 border border-ink-600/60 text-white/80 hover:text-white focus:outline-none focus:ring-2 focus:ring-brand-orange"
					aria-label="Toggle Navigation Menu"
					aria-expanded="false"
				>
					<svg id="menu-icon-bars" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
					<svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>
		</div>

		<!-- Mobile Navigation Drawer -->
		<div id="mobile-menu" class="hidden md:hidden pb-4 pt-2 border-t border-ink-700/60 animate-fade-in">
			<nav class="flex flex-col gap-1.5">
				{navLinks.map((link) => {
					const active = isActive(link.href);
					return (
						<a
							href={link.href}
							class={`px-4 py-2.5 rounded-lg text-base font-medium transition ${
								active
									? 'bg-brand-orange/20 text-brand-orange font-semibold border border-brand-orange/40'
									: 'text-white/80 hover:bg-white/5 hover:text-white'
							}`}
						>
							{link.label}
						</a>
					);
				})}
				<a
					href="/search"
					class="px-4 py-2.5 rounded-lg text-base font-medium text-white/80 hover:bg-white/5 hover:text-white flex items-center justify-between"
				>
					<span>Search Catalog</span>
					<svg class="w-4 h-4 text-brand-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
					</svg>
				</a>
			</nav>
		</div>
	</div>
</header>

<script>
	const menuBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');
	const iconBars = document.getElementById('menu-icon-bars');
	const iconClose = document.getElementById('menu-icon-close');

	if (menuBtn && mobileMenu && iconBars && iconClose) {
		menuBtn.addEventListener('click', () => {
			const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
			menuBtn.setAttribute('aria-expanded', String(!isExpanded));
			mobileMenu.classList.toggle('hidden');
			iconBars.classList.toggle('hidden');
			iconClose.classList.toggle('hidden');
		});
	}

	// Quick search shortcut "/"
	document.addEventListener('keydown', (e) => {
		if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) {
			e.preventDefault();
			window.location.href = '/search';
		}
	});
</script>
