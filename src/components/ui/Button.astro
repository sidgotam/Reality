---
interface Props {
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	variant?: 'primary' | 'secondary' | 'ghost' | 'danger';
	size?: 'sm' | 'md' | 'lg';
	fullWidth?: boolean;
	disabled?: boolean;
	/** When true, renders as an <a> even without href (for SPA routing). */
	as?: 'a' | 'button';
	class?: string;
}

const {
	href,
	type = 'button',
	variant = 'primary',
	size = 'md',
	fullWidth = false,
	disabled = false,
	as,
	class: className = '',
	...rest
} = Astro.props as Props;

const sizes: Record<string, string> = {
	sm: 'px-3 py-1.5 text-sm',
	md: 'px-4 py-2 text-base',
	lg: 'px-6 py-3 text-lg',
};

const variants: Record<string, string> = {
	primary:
		'bg-brand-orange text-black font-semibold hover:bg-brand-orange-soft hover:shadow-glow active:scale-[0.98] transition',
	secondary:
		'bg-ink-700 text-white hover:bg-ink-600 active:scale-[0.98] transition',
	ghost:
		'bg-transparent text-white/90 hover:text-white hover:bg-white/5 active:scale-[0.98] transition',
	danger:
		'bg-brand-red text-white hover:bg-red-600 active:scale-[0.98] transition',
};

const base = `${sizes[size]} ${variants[variant]} rounded-lg inline-flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:shadow-none disabled:active:scale-100 ${fullWidth ? 'w-full' : ''} ${className}`;
---

{href ? (
	<a href={href} class={base} {...rest}>
		<slot />
	</a>
) : (
	<button type={type} class={base} disabled={disabled} {...rest}>
		<slot />
	</button>
)}