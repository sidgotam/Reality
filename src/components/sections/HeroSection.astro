---
import type { CollectionEntry } from 'astro:content';
import Button from '../ui/Button.astro';

interface Props {
	show: CollectionEntry<'shows'>;
	latestEpisode?: CollectionEntry<'episodes'>;
}

const { show, latestEpisode } = Astro.props as Props;

const watchUrl = latestEpisode
	? `/watch/${latestEpisode.data.showSlug}-season-${latestEpisode.data.seasonNumber}-episode-${latestEpisode.data.episodeNumber}`
	: `/shows/${show.data.slug}`;
---

<section class="relative min-h-[75vh] sm:min-h-[82vh] flex items-end overflow-hidden border-b border-ink-700/60" aria-labelledby="hero-title">
	<!-- Background Image with Dark Vignette Gradients -->
	<div class="absolute inset-0 z-0">
		<img
			src={show.data.poster}
			alt=""
			aria-hidden="true"
			class="w-full h-full object-cover scale-105 filter brightness-75"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/80 to-ink/30" />
		<div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-transparent" />
	</div>

	<!-- Content -->
	<div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24 pt-20">
		<div class="max-w-2xl space-y-4">
			<div class="flex flex-wrap items-center gap-2">
				{show.data.trending && (
					<span class="inline-flex items-center gap-1.5 rounded-full bg-brand-orange/25 px-3 py-1 text-xs font-bold text-brand-orange border border-brand-orange/40 animate-fade-in shadow-sm">
						<span class="relative flex h-2 w-2">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-orange opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2 w-2 bg-brand-orange"></span>
						</span>
						#1 Trending Reality Show
					</span>
				)}
				{show.data.featured && (
					<span class="inline-flex items-center gap-1.5 rounded-full bg-brand-red/25 px-3 py-1 text-xs font-bold text-brand-red border border-brand-red/40 shadow-sm">
						★ Featured Selection
					</span>
				)}
			</div>

			<h1 id="hero-title" class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight tracking-tight font-display drop-shadow-md">
				{show.data.name}
			</h1>

			<p class="text-white/80 text-base sm:text-lg leading-relaxed line-clamp-3 max-w-xl">
				{show.data.description}
			</p>

			<div class="flex flex-wrap items-center gap-3 pt-1">
				<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-ink-700/70 text-white/80 text-xs font-semibold border border-ink-600/60 backdrop-blur-xs">
					<svg class="w-4 h-4 text-brand-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 002-2v12a2 2 0 002 2z" /></svg>
					{show.data.seasons} Seasons
				</span>
				{latestEpisode && (
					<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-ink-700/70 text-white/80 text-xs font-semibold border border-ink-600/60 backdrop-blur-xs">
						<svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
						Latest: EP {latestEpisode.data.episodeNumber}
					</span>
				)}
			</div>

			<div class="flex flex-wrap items-center gap-3.5 pt-3">
				<Button href={watchUrl} variant="primary" size="lg">
					<svg class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
						<path d="M8 5v14l11-7z" />
					</svg>
					{latestEpisode ? `Watch EP ${latestEpisode.data.episodeNumber}` : 'Watch Now'}
				</Button>
				<Button href={`/shows/${show.data.slug}`} variant="secondary" size="lg">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
					Show Details & Seasons
				</Button>
			</div>
		</div>
	</div>
</section>